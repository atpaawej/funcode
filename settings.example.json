{
  "provider": {
    "base_url": "https://api.openai.com/v1",
    "api_key": "${OPENAI_API_KEY}",
    "model": "gpt-4o-mini"
  },
  "agent": {
    "max_turns": 25,
    "auto_approve": false,
    "cwd": ".",
    "stream": true,
    "show_thinking": true,
    "verbose": false
  },
  "web": {
    "tinyfish_api_key": "${TINYFISH_API_KEY}"
  }
}
