{
  "provider": {
    "base_url": "https://api.openai.com/v1",
    "api_key": "${OPENAI_API_KEY}",
    "model": "gpt-4o-mini"
  },
  "agent": {
    "max_turns": 25,
    "auto_approve": false,
    "cwd": ".",
    "stream": true,
    "show_thinking": true,
    "verbose": false,
    "context_window": 0,
    "compact_cap": 300000,
    "auto_compact_fraction": 0.85,
    "compact_keep_last": 2
  },
  "web": {
    "tinyfish_api_key": "${TINYFISH_API_KEY}"
  }
}
